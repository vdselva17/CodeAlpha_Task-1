<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Basic Calculator (+, -, *, /)</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background-color: #f0f2f5;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }

    .calculator {
      background-color: #ffffff;
      padding: 24px;
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      width: 320px;
    }

    .title {
      text-align: center;
      margin-bottom: 16px;
      color: #333;
      font-size: 1.2rem;
    }

    #display {
      width: 100%;
      height: 60px;
      background-color: #222;
      color: #00ff88;
      font-size: 2rem;
      text-align: right;
      padding: 10px 16px;
      border: none;
      border-radius: 8px;
      margin-bottom: 20px;
      outline: none;
    }

    .buttons {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    button {
      height: 56px;
      font-size: 1.3rem;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      background-color: #e9ecef;
      color: #333;
      transition: background-color 0.15s, transform 0.05s;
    }

    button:hover {
      background-color: #dee2e6;
    }

    button:active {
      transform: scale(0.96);
    }

    /* Operator buttons (+, -, *, /) */
    button.operator {
      background-color: #ff9800;
      color: white;
      font-weight: bold;
    }

    button.operator:hover {
      background-color: #e68a00;
    }

    /* Clear button (C) */
    button.clear {
      background-color: #f44336;
      color: white;
      font-weight: bold;
      grid-column: span 2;
    }

    button.clear:hover {
      background-color: #d32f2f;
    }

    /* Equal button (=) */
    button.equal {
      background-color: #4caf50;
      color: white;
      font-weight: bold;
      grid-column: span 2;
    }

    button.equal:hover {
      background-color: #388e3c;
    }
  </style>
</head>
<body>

  <div class="calculator">
    <h2 class="title">Basic Calculator</h2>
    
    <!-- Display Screen -->
    <input type="text" id="display" value="0" readonly>

    <!-- Keypad -->
    <div class="buttons">
      <!-- Clear and Division/Multiplication -->
      <button class="clear" onclick="clearDisplay()">C</button>
      <button class="operator" onclick="appendOperator('/')">÷</button>
      <button class="operator" onclick="appendOperator('*')">×</button>

      <!-- Row 1: 7, 8, 9, - -->
      <button onclick="appendNumber('7')">7</button>
      <button onclick="appendNumber('8')">8</button>
      <button onclick="appendNumber('9')">9</button>
      <button class="operator" onclick="appendOperator('-')">−</button>

      <!-- Row 2: 4, 5, 6, + -->
      <button onclick="appendNumber('4')">4</button>
      <button onclick="appendNumber('5')">5</button>
      <button onclick="appendNumber('6')">6</button>
      <button class="operator" onclick="appendOperator('+')">+</button>

      <!-- Row 3: 1, 2, 3, . -->
      <button onclick="appendNumber('1')">1</button>
      <button onclick="appendNumber('2')">2</button>
      <button onclick="appendNumber('3')">3</button>
      <button onclick="appendNumber('.')">.</button>

      <!-- Row 4: 0, = -->
      <button onclick="appendNumber('0')">0</button>
      <button class="equal" onclick="calculate()">=</button>
    </div>
  </div>

  <!-- JavaScript Logic -->
  <script>
    let firstOperand = '';
    let operator = '';
    let waitingForSecondOperand = false;
    const display = document.getElementById('display');

    // Append a number (0-9) or decimal (.)
    function appendNumber(num) {
      if (waitingForSecondOperand) {
        display.value = num === '.' ? '0.' : num;
        waitingForSecondOperand = false;
      } else {
        if (num === '.' && display.value.includes('.')) return;
        display.value = (display.value === '0' && num !== '.') ? num : display.value + num;
      }
    }

    // Set an operator (+, -, *, /)
    function appendOperator(op) {
      if (operator && !waitingForSecondOperand) {
        calculate();
      }
      firstOperand = display.value;
      operator = op;
      waitingForSecondOperand = true;
    }

    // Perform the calculation (+, -, *, /)
    function calculate() {
      if (!operator || waitingForSecondOperand) return;

      const num1 = parseFloat(firstOperand);
      const num2 = parseFloat(display.value);
      let result = 0;

      switch (operator) {
        case '+':
          result = num1 + num2;
          break;
        case '-':
          result = num1 - num2;
          break;
        case '*':
          result = num1 * num2;
          break;
        case '/':
          if (num2 === 0) {
            display.value = "Error";
            firstOperand = '';
            operator = '';
            waitingForSecondOperand = true;
            return;
          }
          result = num1 / num2;
          break;
      }

      // Round to prevent long floating decimals (e.g. 0.1 + 0.2)
      result = Math.round(result * 100000000) / 100000000;
      display.value = result;
      firstOperand = result;
      operator = '';
      waitingForSecondOperand = true;
    }

    // Clear display
    function clearDisplay() {
      display.value = '0';
      firstOperand = '';
      operator = '';
      waitingForSecondOperand = false;
    }
  </script>
</body>
</html>
