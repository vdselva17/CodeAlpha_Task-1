<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aura — Modern Responsive Image Gallery</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ==========================================================================
       CSS Reset & Variables
       ========================================================================== */
    :root {
      --bg-main: #0b0f19;
      --bg-card: rgba(22, 29, 49, 0.7);
      --bg-card-hover: rgba(30, 41, 69, 0.9);
      --border-color: rgba(255, 255, 255, 0.08);
      --border-glow: rgba(99, 102, 241, 0.3);
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --primary-gradient: linear-gradient(135deg, #6366f1, #a855f7);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent: #ec4899;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
      --shadow-md: 0 12px 24px -4px rgba(0, 0, 0, 0.4);
      --shadow-lg: 0 20px 40px -8px rgba(0, 0, 0, 0.6);
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-main);
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
      line-height: 1.6;
      background-image: 
        radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.12) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(168, 85, 247, 0.12) 0px, transparent 50%);
      background-attachment: fixed;
    }

    /* ==========================================================================
       Header & Hero Section
       ========================================================================== */
    header {
      padding: 3.5rem 1.5rem 2rem;
      text-align: center;
      max-width: 900px;
      margin: 0 auto;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      background: rgba(99, 102, 241, 0.15);
      border: 1px solid rgba(99, 102, 241, 0.3);
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 600;
      color: #a5b4fc;
      margin-bottom: 1.25rem;
      letter-spacing: 0.02em;
    }

    header h1 {
      font-size: 2.75rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      margin-bottom: 0.75rem;
      background: linear-gradient(135deg, #ffffff 40%, #94a3b8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    header p {
      color: var(--text-muted);
      font-size: 1.1rem;
      max-width: 600px;
      margin: 0 auto 2rem;
    }

    /* ==========================================================================
       Controls: Search & Filter Tabs
       ========================================================================== */
    .controls {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
      margin-bottom: 2.5rem;
    }

    .search-wrapper {
      position: relative;
      width: 100%;
      max-width: 440px;
    }

    .search-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      width: 18px;
      height: 18px;
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      padding: 0.85rem 1rem 0.85rem 2.75rem;
      background: rgba(22, 29, 49, 0.6);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      color: var(--text-main);
      font-family: inherit;
      font-size: 0.95rem;
      outline: none;
      backdrop-filter: blur(10px);
      transition: var(--transition);
    }

    .search-input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2);
      background: rgba(30, 41, 69, 0.8);
    }

    .filter-tabs {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
    }

    .filter-btn {
      padding: 0.6rem 1.25rem;
      border: 1px solid var(--border-color);
      background: rgba(22, 29, 49, 0.5);
      color: var(--text-muted);
      border-radius: 9999px;
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      backdrop-filter: blur(10px);
      transition: var(--transition);
    }

    .filter-btn:hover {
      color: var(--text-main);
      background: rgba(30, 41, 69, 0.8);
      border-color: rgba(255, 255, 255, 0.2);
      transform: translateY(-1px);
    }

    .filter-btn.active {
      background: var(--primary-gradient);
      color: #ffffff;
      border-color: transparent;
      box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);
    }

    /* ==========================================================================
       Gallery Grid Layout
       ========================================================================== */
    .gallery-container {
      max-width: 1320px;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.75rem;
    }

    .gallery-card {
      position: relative;
      border-radius: var(--radius-md);
      overflow: hidden;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      box-shadow: var(--shadow-sm);
      transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.4s ease, border-color 0.4s ease;
      cursor: pointer;
      aspect-ratio: 4 / 3;
    }

    .gallery-card:hover {
      transform: translateY(-6px) scale(1.01);
      box-shadow: var(--shadow-lg);
      border-color: var(--border-glow);
    }

    .gallery-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .gallery-card:hover img {
      transform: scale(1.08);
    }

    /* Card Badge */
    .card-category {
      position: absolute;
      top: 1rem;
      left: 1rem;
      z-index: 2;
      background: rgba(11, 15, 25, 0.7);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      color: #e2e8f0;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    /* Card Overlay */
    .card-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(11, 15, 25, 0.95) 0%, rgba(11, 15, 25, 0.4) 50%, transparent 100%);
      opacity: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 1.5rem;
      z-index: 1;
      transition: opacity 0.35s ease;
    }

    .gallery-card:hover .card-overlay {
      opacity: 1;
    }

    .overlay-info h3 {
      font-size: 1.15rem;
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 0.25rem;
      transform: translateY(10px);
      transition: transform 0.35s ease;
    }

    .overlay-info p {
      font-size: 0.85rem;
      color: var(--text-muted);
      transform: translateY(10px);
      transition: transform 0.35s ease 0.05s;
    }

    .gallery-card:hover .overlay-info h3,
    .gallery-card:hover .overlay-info p {
      transform: translateY(0);
    }

    .overlay-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 1rem;
      transform: translateY(10px);
      transition: transform 0.35s ease 0.1s;
    }

    .gallery-card:hover .overlay-actions {
      transform: translateY(0);
    }

    .view-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      color: #a5b4fc;
      background: none;
      border: none;
      cursor: pointer;
    }

    .like-btn {
      background: rgba(255, 255, 255, 0.1);
      border: none;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      cursor: pointer;
      transition: var(--transition);
    }

    .like-btn:hover {
      background: rgba(255, 255, 255, 0.2);
      transform: scale(1.1);
    }

    .like-btn.liked {
      background: rgba(236, 72, 153, 0.2);
      color: var(--accent);
    }

    .like-btn.liked svg {
      fill: var(--accent);
    }

    /* Empty state */
    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 4rem 1rem;
      color: var(--text-muted);
    }

    .empty-state svg {
      width: 56px;
      height: 56px;
      margin-bottom: 1rem;
      opacity: 0.4;
    }

    /* ==========================================================================
       Lightbox Modal
       ========================================================================== */
    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 999;
      background: rgba(5, 8, 15, 0.94);
      backdrop-filter: blur(16px);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      padding: 1.5rem;
    }

    .lightbox.active {
      opacity: 1;
      pointer-events: auto;
    }

    .lightbox-content {
      position: relative;
      max-width: 1000px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .lightbox-img-wrapper {
      position: relative;
      width: 100%;
      max-height: 72vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .lightbox-img {
      max-width: 100%;
      max-height: 72vh;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-lg);
      object-fit: contain;
      animation: zoomIn 0.3s ease;
    }

    @keyframes zoomIn {
      from { transform: scale(0.95); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .lightbox-caption {
      margin-top: 1rem;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: var(--text-main);
      padding: 0 0.5rem;
    }

    .lightbox-details h4 {
      font-size: 1.15rem;
      font-weight: 600;
    }

    .lightbox-details p {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .lightbox-counter {
      font-size: 0.85rem;
      color: var(--text-muted);
      background: rgba(255, 255, 255, 0.08);
      padding: 4px 12px;
      border-radius: 9999px;
    }

    /* Modal Navigation Buttons */
    .lightbox-btn {
      position: absolute;
      background: rgba(22, 29, 49, 0.7);
      border: 1px solid var(--border-color);
      color: #fff;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      backdrop-filter: blur(8px);
      transition: var(--transition);
      z-index: 10;
    }

    .lightbox-btn:hover {
      background: rgba(99, 102, 241, 0.8);
      transform: scale(1.1);
    }

    .lightbox-close {
      top: 1.5rem;
      right: 1.5rem;
    }

    .lightbox-prev {
      left: 1.5rem;
      top: 50%;
      transform: translateY(-50%);
    }

    .lightbox-next {
      right: 1.5rem;
      top: 50%;
      transform: translateY(-50%);
    }

    .lightbox-prev:hover {
      transform: translateY(-50%) scale(1.1);
    }

    .lightbox-next:hover {
      transform: translateY(-50%) scale(1.1);
    }

    /* ==========================================================================
       Responsive Breakpoints
       ========================================================================== */
    @media (max-width: 768px) {
      header h1 {
        font-size: 2.1rem;
      }
      .gallery-grid {
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.25rem;
      }
      .lightbox-prev {
        left: 0.5rem;
      }
      .lightbox-next {
        right: 0.5rem;
      }
      .lightbox-close {
        top: 0.75rem;
        right: 0.75rem;
      }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/>
      </svg>
      Curated Photography
    </div>
    <h1>Visual Canvas Gallery</h1>
    <p>Discover an inspiring collection of landscapes, modern architecture, and scenic world journeys.</p>

    <!-- Controls: Search & Categories -->
    <div class="controls">
      <div class="search-wrapper">
        <svg class="search-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" id="searchInput" class="search-input" placeholder="Search photos by title or keyword..." autocomplete="off">
      </div>

      <div class="filter-tabs" id="filterTabs">
        <button class="filter-btn active" data-filter="all">All Photos</button>
        <button class="filter-btn" data-filter="nature">Nature</button>
        <button class="filter-btn" data-filter="architecture">Architecture</button>
        <button class="filter-btn" data-filter="travel">Travel</button>
        <button class="filter-btn" data-filter="wildlife">Wildlife</button>
      </div>
    </div>
  </header>

  <!-- Gallery Grid Container -->
  <main class="gallery-container">
    <div class="gallery-grid" id="galleryGrid">
      <!-- Items dynamically populated via JavaScript -->
    </div>
  </main>

  <!-- Lightbox Modal -->
  <div class="lightbox" id="lightbox" aria-modal="true" role="dialog">
    <button class="lightbox-btn lightbox-close" id="closeBtn" aria-label="Close modal">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <button class="lightbox-btn lightbox-prev" id="prevBtn" aria-label="Previous photo">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button class="lightbox-btn lightbox-next" id="nextBtn" aria-label="Next photo">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <div class="lightbox-content">
      <div class="lightbox-img-wrapper">
        <img src="" alt="" class="lightbox-img" id="lightboxImg">
      </div>
      <div class="lightbox-caption">
        <div class="lightbox-details">
          <h4 id="lightboxTitle">Title</h4>
          <p id="lightboxAuthor">Photo by Author</p>
        </div>
        <span class="lightbox-counter" id="lightboxCounter">1 / 12</span>
      </div>
    </div>
  </div>

  <!-- JavaScript Logic -->
  <script>
    // Gallery Dataset
    const galleryItems = [
      {
        id: 1,
        title: "Alpine Serenity",
        author: "Kalum Mclean",
        category: "nature",
        src: "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1200&q=80",
        tags: ["mountain", "snow", "peak", "nature", "clouds"]
      },
      {
        id: 2,
        title: "Metropolis Facade",
        author: "Sam Valadi",
        category: "architecture",
        src: "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80",
        tags: ["building", "skyscraper", "glass", "city", "modern"]
      },
      {
        id: 3,
        title: "Venetian Glow",
        author: "Clay Banks",
        category: "travel",
        src: "https://images.unsplash.com/photo-1514890547357-a9ee288728e0?auto=format&fit=crop&w=1200&q=80",
        tags: ["venice", "italy", "canal", "gondola", "water", "sunset"]
      },
      {
        id: 4,
        title: "Curious Red Fox",
        author: "Ray Hennessy",
        category: "wildlife",
        src: "https://images.unsplash.com/photo-1474511320723-9a56873ee67b?auto=format&fit=crop&w=1200&q=80",
        tags: ["fox", "animal", "wildlife", "fur", "cute"]
      },
      {
        id: 5,
        title: "Misty Pine Forest",
        author: "Casey Horner",
        category: "nature",
        src: "https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=1200&q=80",
        tags: ["forest", "trees", "fog", "pine", "green", "mystic"]
      },
      {
        id: 6,
        title: "Monochrome Geometry",
        author: "Simone Hutsch",
        category: "architecture",
        src: "https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=1200&q=80",
        tags: ["minimal", "lines", "angles", "monochrome", "pattern"]
      },
      {
        id: 7,
        title: "Sahara Ripples",
        author: "Keith Hardy",
        category: "travel",
        src: "https://images.unsplash.com/photo-1509316975850-ff9c5deb0cd9?auto=format&fit=crop&w=1200&q=80",
        tags: ["desert", "sand", "dunes", "dramatic", "africa"]
      },
      {
        id: 8,
        title: "Gaze of the Hawk",
        author: "Vincent van Zalinge",
        category: "wildlife",
        src: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1200&q=80",
        tags: ["bird", "hawk", "raptor", "feathers", "predator"]
      },
      {
        id: 9,
        title: "Golden Coastline",
        author: "Sean Oulashin",
        category: "nature",
        src: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80",
        tags: ["beach", "ocean", "waves", "summer", "paradise"]
      },
      {
        id: 10,
        title: "Suspension Lights",
        author: "Dan Freeman",
        category: "architecture",
        src: "https://images.unsplash.com/photo-1519501025264-65ba15a82390?auto=format&fit=crop&w=1200&q=80",
        tags: ["bridge", "night", "city", "structure", "golden gate"]
      },
      {
        id: 11,
        title: "Aegean Azure",
        author: "Heidi Kaden",
        category: "travel",
        src: "https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=1200&q=80",
        tags: ["greece", "santorini", "sea", "islands", "white"]
      },
      {
        id: 12,
        title: "Morning Mist Stag",
        author: "Dan Meyers",
        category: "wildlife",
        src: "https://images.unsplash.com/photo-1484406566174-9da000fda645?auto=format&fit=crop&w=1200&q=80",
        tags: ["deer", "stag", "antlers", "mist", "forest"]
      }
    ];

    // DOM Elements
    const galleryGrid = document.getElementById('galleryGrid');
    const filterTabs = document.getElementById('filterTabs');
    const searchInput = document.getElementById('searchInput');

    // Lightbox Elements
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightboxImg');
    const lightboxTitle = document.getElementById('lightboxTitle');
    const lightboxAuthor = document.getElementById('lightboxAuthor');
    const lightboxCounter = document.getElementById('lightboxCounter');
    const closeBtn = document.getElementById('closeBtn');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');

    let currentFilter = 'all';
    let searchQuery = '';
    let visibleItems = [...galleryItems];
    let currentIndex = 0;

    // Render Gallery
    function renderGallery() {
      galleryGrid.innerHTML = '';

      visibleItems = galleryItems.filter(item => {
        const matchesFilter = currentFilter === 'all' || item.category === currentFilter;
        const matchesSearch = item.title.toLowerCase().includes(searchQuery) ||
                              item.tags.some(tag => tag.toLowerCase().includes(searchQuery)) ||
                              item.author.toLowerCase().includes(searchQuery);
        return matchesFilter && matchesSearch;
      });

      if (visibleItems.length === 0) {
        galleryGrid.innerHTML = `
          <div class="empty-state">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
            </svg>
            <h3>No matching photos found</h3>
            <p>Try searching for different keywords or clear the category filter.</p>
          </div>
        `;
        return;
      }

      visibleItems.forEach((item, index) => {
        const card = document.createElement('div');
        card.className = 'gallery-card';
        card.innerHTML = `
          <span class="card-category">${item.category}</span>
          <img src="${item.src}" alt="${item.title}" loading="lazy">
          <div class="card-overlay">
            <div class="overlay-info">
              <h3>${item.title}</h3>
              <p>by ${item.author}</p>
            </div>
            <div class="overlay-actions">
              <button class="view-btn" aria-label="Expand image">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 3h6v6m0-6L10 14M9 21H3v-6m0 6l11-11"/>
                </svg>
                Preview
              </button>
              <button class="like-btn" aria-label="Like photo" onclick="toggleLike(event, this)">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </button>
            </div>
          </div>
        `;

        card.addEventListener('click', (e) => {
          if (!e.target.closest('.like-btn')) {
            openLightbox(index);
          }
        });

        galleryGrid.appendChild(card);
      });
    }

    // Like Button Toggle
    function toggleLike(event, button) {
      event.stopPropagation();
      button.classList.toggle('liked');
    }

    // Lightbox Handlers
    function openLightbox(index) {
      currentIndex = index;
      updateLightbox();
      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    }

    function updateLightbox() {
      const item = visibleItems[currentIndex];
      lightboxImg.src = item.src;
      lightboxImg.alt = item.title;
      lightboxTitle.textContent = item.title;
      lightboxAuthor.textContent = `Photo by ${item.author} • ${item.category.toUpperCase()}`;
      lightboxCounter.textContent = `${currentIndex + 1} / ${visibleItems.length}`;
    }

    function showNext() {
      if (visibleItems.length <= 1) return;
      currentIndex = (currentIndex + 1) % visibleItems.length;
      updateLightbox();
    }

    function showPrev() {
      if (visibleItems.length <= 1) return;
      currentIndex = (currentIndex - 1 + visibleItems.length) % visibleItems.length;
      updateLightbox();
    }

    // Filter Buttons Click
    filterTabs.addEventListener('click', (e) => {
      if (e.target.classList.contains('filter-btn')) {
        document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
        e.target.classList.add('active');
        currentFilter = e.target.dataset.filter;
        renderGallery();
      }
    });

    // Search Input Event
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      renderGallery();
    });

    // Lightbox Controls Events
    closeBtn.addEventListener('click', closeLightbox);
    nextBtn.addEventListener('click', (e) => { e.stopPropagation(); showNext(); });
    prevBtn.addEventListener('click', (e) => { e.stopPropagation(); showPrev(); });

    // Backdrop Click to Close
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target.classList.contains('lightbox-content') || e.target.classList.contains('lightbox-img-wrapper')) {
        closeLightbox();
      }
    });

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    });

    // Initial Render
    renderGallery();
  </script>
</body>
</html>
